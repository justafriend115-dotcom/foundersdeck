# Postgres (required — production and dev share the same provider)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth session signing secret — REQUIRED in production. The app refuses to
# issue or read sessions when this is missing in production (no fallback).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# FD_AUTH_SECRET=""

# At-rest encryption key for sensitive data (32+ random bytes, base64) —
# REQUIRED in production. Encryption throws without it; no dev fallback.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# FD_ENCRYPTION_KEY=""

# AI provider keys — leave empty to use the built-in mock AI.
# Set one of these and FoundersDeck switches to the real provider automatically.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# NVIDIA NIM Qwen image generation + editing (pitch deck slide visuals, server-side only).
# Leave empty to disable slide images.
QWEN_IMAGE_API_KEY=""
QWEN_IMAGE_EDIT_API_KEY=""
# NVIDIA NIM image endpoints (defaults: flux.1-dev generation + flux.1-kontext-dev edit).
# Point these at the qwen-image / qwen-image-edit endpoints when available on your account.
# QWEN_IMAGE_API_URL="https://ai.api.nvidia.com/v1/genai/qwen/qwen-image"
# QWEN_IMAGE_EDIT_API_URL="https://ai.api.nvidia.com/v1/genai/qwen/qwen-image-edit"

# Optional model overrides
# AI_MODEL_OPENAI="gpt-4o-mini"
# AI_MODEL_ANTHROPIC="claude-3-5-haiku-latest"

# Stripe — leave empty to run billing in demo (stub) mode.
# In stub mode, "Upgrade to Pro" simulates checkout and upgrades instantly.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ID of your Pro monthly subscription price
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# Price ID of your DECKADEMY membership subscription price
# STRIPE_PRICE_DECKADEMY_MONTHLY="price_..."

# Analytics — leave empty for no analytics. Set to your GA4 measurement id.
NEXT_PUBLIC_GA_ID=""
# Public app URL, used for SEO metadata, sitemap and OG image
# NEXT_PUBLIC_APP_URL="https://foundersdeck.app"

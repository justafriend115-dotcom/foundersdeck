generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  name                  String
  email                 String   @unique
  passwordHash          String
  plan                  String   @default("free")
  deckademyPlan         String   @default("free")
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  bypassCaps            Boolean  @default(false)
  businessPlanCompleted Boolean  @default(false)
  isAdmin               Boolean  @default(false)
  suspiciousActivity    Boolean  @default(false)
  orgId                 String?
  createdAt             DateTime @default(now())

  pitchDecks     PitchDeck[]
  businessPlan   BusinessPlan?
  contingency    ContingencyPlan?
  financials     FinancialProjection?
  investors      Investor[]
  academy        AcademyProgress[]
  org            Organization?   @relation(fields: [orgId], references: [id])
  generationLogs GenerationLog[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   User[]
}

model GenerationLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool          String
  estimatedCost Float    @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  refused       Boolean  @default(false)
  refuseReason  String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model AcademyProgress {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId           String
  score             Int       @default(0)
  passed            Boolean   @default(false)
  completedLessons  String    @default("[]")
  examScore         Int       @default(0)
  examPassed        Boolean   @default(false)
  quizLockedUntil   DateTime?
  examLockedUntil   DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([userId, trackId])
}

model PitchDeck {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  regenCount  Int      @default(0)
  watermarked Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model BusinessPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  updatedAt DateTime @updatedAt
}

model ContingencyPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  updatedAt DateTime @updatedAt
}

model FinancialProjection {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  updatedAt DateTime @updatedAt
}

model Investor {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  firm      String
  stage     String   @default("cold")
  notes     String   @default("")
  createdAt DateTime @default(now())
  meetings  Meeting[]
}

model Meeting {
  id         String   @id
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  date       String
  outcome    String
  followUp   String   @default("")
  createdAt  DateTime @default(now())
}
